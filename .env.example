# ---- 复制成 .env 再填 ----

# PostgreSQL 连接串（库名用 db:create 创建出来的那个）
DATABASE_URL=postgresql://user:password@host:5432/ucs

# HTTP 服务
HOST=0.0.0.0
PORT=8787

# 对外可访问的基址，用于拼接回调地址和 JWT iss，必须与真实部署一致
PUBLIC_BASE_URL=https://your-api.example.com

# 我的 toy：所有玩家的身份都锚定在这个 toy 的 toyOpenId 上
MY_TOY_ID=0
MY_TOY_SLUG=xxxxxxxxxxxxxxxx

# 允许跨域调用本 API 的前端源（toy 的内层 iframe 固定是这个域）
ALLOWED_ORIGINS=https://www.bilibilitoy.com

# 令牌有效期
JWT_TTL_SECONDS=900
AUTH_CODE_TTL_SECONDS=60
CLAIM_NONCE_TTL_HOURS=24
CLAIM_MAX_ATTEMPTS=10

# 只有在反向代理（nginx/SLB）后面才设为 true，否则可伪造 IP 绕过限流
TRUST_PROXY=false
